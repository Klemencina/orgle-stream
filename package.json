{
  "name": "orgle-stream",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build --turbopack",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@clerk/nextjs": "^6.39.6",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^1.6.1",
    "hls.js": "^1.7.2",
    "next": "15.5.25",
    "next-intl": "^4.14.2",
    "prisma": "^6.19.3",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "stripe": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.28",
      "@prisma/config>deepmerge-ts": "8.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@swc/core",
      "unrs-resolver",
      "@parcel/watcher"
    ]
  }
}
